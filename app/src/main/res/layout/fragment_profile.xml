<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/night"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:padding="18dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Page title -->
        <TextView
            android:text="Profile"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/text_main"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:text="Manage your account and profile settings"
            android:textColor="@color/text_soft"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="14dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- Profile image card -->
        <LinearLayout
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/card_glow"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/profileImage"
                android:src="@android:drawable/ic_menu_camera"
                android:background="@drawable/card_bg"
                android:padding="8dp"
                android:scaleType="centerCrop"
                android:layout_width="120dp"
                android:layout_height="120dp" />

            <TextView
                android:id="@+id/imageSourceText"
                android:text="Profile image source: none"
                android:textColor="@color/text_soft"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginTop="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <Button
                    android:id="@+id/takePhotoButton"
                    android:text="Camera"
                    android:textColor="@color/white"
                    android:background="@drawable/button_bg"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="48dp" />

                <Button
                    android:id="@+id/chooseGalleryButton"
                    android:text="Gallery"
                    android:textColor="@color/white"
                    android:background="@drawable/button_bg"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="48dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- User info card -->
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginTop="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:text="Account Information"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/cyan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/userNameText"
                android:text="Name:"
                android:textColor="@color/text_main"
                android:textSize="16sp"
                android:layout_marginTop="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/userEmailText"
                android:text="Email:"
                android:textColor="@color/text_soft"
                android:textSize="15sp"
                android:layout_marginTop="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <!-- Change password card -->
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginTop="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:text="Change Password"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/cyan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <EditText
                android:id="@+id/oldPasswordInput"
                android:hint="Current password"
                android:inputType="textPassword"
                android:textColor="@color/text_main"
                android:textColorHint="@color/text_soft"
                android:background="@drawable/input_bg"
                android:layout_marginTop="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <EditText
                android:id="@+id/newPasswordInput"
                android:hint="New password"
                android:inputType="textPassword"
                android:textColor="@color/text_main"
                android:textColorHint="@color/text_soft"
                android:background="@drawable/input_bg"
                android:layout_marginTop="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <EditText
                android:id="@+id/confirmNewPasswordInput"
                android:hint="Confirm new password"
                android:inputType="textPassword"
                android:textColor="@color/text_main"
                android:textColorHint="@color/text_soft"
                android:background="@drawable/input_bg"
                android:layout_marginTop="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/changePasswordButton"
                android:text="Update Password"
                android:textColor="@color/white"
                android:background="@drawable/button_bg"
                android:layout_marginTop="12dp"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

        </LinearLayout>

        <!-- Project info card -->
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginTop="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:text="About CryptoPulse"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/cyan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:text="CryptoPulse uses local authentication, Room database, Retrofit API communication, RecyclerView lists, favorites, search filters, profile image handling, and implicit intents."
                android:textColor="@color/text_soft"
                android:textSize="15sp"
                android:layout_marginTop="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <!-- Action buttons -->
        <Button
            android:id="@+id/emailButton"
            android:text="Contact Developer"
            android:textColor="@color/white"
            android:background="@drawable/button_bg"
            android:layout_marginTop="16dp"
            android:layout_width="match_parent"
            android:layout_height="52dp" />

        <Button
            android:id="@+id/logoutButton"
            android:text="Logout"
            android:textColor="@color/white"
            android:backgroundTint="@color/red"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="52dp" />

    </LinearLayout>

</ScrollView>