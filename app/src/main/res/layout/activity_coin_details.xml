<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/night"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/backButton"
            android:text="← Back"
            android:textColor="@color/cyan"
            android:backgroundTint="@color/card"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/card_glow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/detailImage"
                android:layout_gravity="center"
                android:layout_width="84dp"
                android:layout_height="84dp"/>

            <TextView
                android:id="@+id/detailName"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/text_main"
                android:gravity="center"
                android:layout_marginTop="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/detailPrice"
                android:textSize="21sp"
                android:textStyle="bold"
                android:textColor="@color/cyan"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <com.unyt.cryptopulse.views.MiniChartView
                android:id="@+id/detailChart"
                android:layout_marginTop="18dp"
                android:layout_width="match_parent"
                android:layout_height="160dp"/>

        </LinearLayout>

        <TextView
            android:id="@+id/detailInfo"
            android:textSize="16sp"
            android:textColor="@color/text_soft"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginTop="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/saveButton"
            android:text="Save to Favorites"
            android:textColor="@color/white"
            android:background="@drawable/button_bg"
            android:layout_marginTop="18dp"
            android:layout_width="match_parent"
            android:layout_height="52dp"/>

        <Button
            android:id="@+id/shareButton"
            android:text="Share Coin"
            android:textColor="@color/cyan"
            android:backgroundTint="@color/card"
            android:layout_width="match_parent"
            android:layout_height="52dp"/>

        <Button
            android:id="@+id/browserButton"
            android:text="Open on CoinGecko"
            android:textColor="@color/cyan"
            android:backgroundTint="@color/card"
            android:layout_width="match_parent"
            android:layout_height="52dp"/>

    </LinearLayout>

</ScrollView>